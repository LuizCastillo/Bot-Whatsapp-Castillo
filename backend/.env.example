# --- App ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
# Origens permitidas (separadas por virgula). Nunca use *.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Segredo compartilhado com o proxy do Next.js (mesmo valor no frontend)
PROXY_SHARED_SECRET=troque-por-um-segredo-longo
SESSION_EXPIRE_MINUTES=480

# --- Banco (Supabase Postgres - use a connection string do pooler) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# --- Supabase Storage (fotos; bucket PRIVADO) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fotos-avaliacoes

# --- Meta / WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
META_APP_SECRET=

# --- Negocio ---
NOME_OFICINA=Oficina Castillo
ENDERECO_OFICINA=
CONVERSA_TIMEOUT_HORAS=12
AGENDAMENTO_STATUS_INICIAL=PENDENTE     # PENDENTE | CONFIRMADO
CANCELAMENTO_ANTECEDENCIA_HORAS=2
MAX_FOTO_MB=10
